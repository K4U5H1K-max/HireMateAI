# Copy this file to .env and fill in the values for your Firebase projects.

# Candidate Firebase project
VITE_CANDIDATE_FIREBASE_API_KEY=your-candidate-api-key
VITE_CANDIDATE_FIREBASE_AUTH_DOMAIN=your-candidate-auth-domain
VITE_CANDIDATE_FIREBASE_PROJECT_ID=your-candidate-project-id
VITE_CANDIDATE_FIREBASE_STORAGE_BUCKET=your-candidate-storage-bucket
VITE_CANDIDATE_FIREBASE_MESSAGING_SENDER_ID=your-candidate-messaging-sender-id
VITE_CANDIDATE_FIREBASE_APP_ID=your-candidate-app-id
VITE_CANDIDATE_FIREBASE_MEASUREMENT_ID=your-candidate-measurement-id

# Employer Firebase project
VITE_EMPLOYER_FIREBASE_API_KEY=your-employer-api-key
VITE_EMPLOYER_FIREBASE_AUTH_DOMAIN=your-employer-auth-domain
VITE_EMPLOYER_FIREBASE_PROJECT_ID=your-employer-project-id
VITE_EMPLOYER_FIREBASE_STORAGE_BUCKET=your-employer-storage-bucket
VITE_EMPLOYER_FIREBASE_MESSAGING_SENDER_ID=your-employer-messaging-sender-id
VITE_EMPLOYER_FIREBASE_APP_ID=your-employer-app-id
VITE_EMPLOYER_FIREBASE_MEASUREMENT_ID=your-employer-measurement-id